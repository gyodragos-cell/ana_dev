    "configuration": {
      "title": "ANA MAX",
      "properties": {
        "anaMax.safeMode": {
          "type": "boolean",
          "default": true,
          "description": "Keep ANA MAX extension actions in safe-mode."
        },
        "anaMax.runtimeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8766/mcp",
          "description": "ANA MAX MCP or runtime endpoint."
        },
        "anaMax.runtimeRoot": {
          "type": "string",
          "default": "",
          "description": "Local ANA MAX runtime root used by the start command. Defaults to the open workspace folder. In Remote/WSL/SSH windows, set this to the Windows ANA_MAX folder when using local desktop tools."
        },
        "anaMax.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python executable path. Defaults to runtimeRoot\\venv\\Scripts\\python.exe."
        },
        "anaMax.runtimePort": {
          "type": "number",
          "default": 8766,
          "description": "ANA MAX MCP port used by the start command."
        },
        "anaMax.dashboardUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Legacy dashboard endpoint. The Activity Bar dashboard command now generates a local HTML dashboard from the live MCP runtime."
        },
        "anaMax.preferredBrowserPath": {
          "type": "string",
          "default": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
          "description": "Preferred browser executable for local generated ANA HTML reports. Falls back to VS Code openExternal if unavailable."
        },
        "anaMax.codexServerName": {
          "type": "string",
          "default": "anamax",
          "description": "Codex MCP server name for the ANA MAX runtime."
        },
        "anaMax.autoStartRuntime": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Live Console and start or attach to the ANA MAX MCP runtime when the extension activates."
        },
        "anaMax.goldenRulePreflight": {
          "type": "boolean",
          "default": true,
          "description": "Run the ANA Codex Companion preflight before high-impact Activity Bar actions so Codex does not work blind."
        },
        "anaMax.codexGuardAutoStart": {
          "type": "boolean",
          "default": true,
          "description": "After ANA MCP becomes ready, automatically run an audible ANA Guard check so Codex cannot silently proceed without ANA evidence."
        },
        "anaMax.codexGuardMinIntervalMs": {
          "type": "number",
          "default": 60000,
          "description": "Minimum delay between automatic ANA Guard checks."
        },
        "anaMax.codexGuardStrict": {
          "type": "boolean",
          "default": false,
          "description": "Treat ANA Guard WARN as blocking. Keep disabled in the lab unless Billy asks for strict stop-on-warn behavior."
        },
        "anaMax.voiceReadout": {
          "type": "boolean",
          "default": true,
          "description": "Speak important ANA Live Console decisions and warnings through the local chat voice bridge."
        },
        "anaMax.voiceReadoutDirect": {
          "type": "boolean",
          "default": false,
          "description": "Also speak filtered Live Console lines directly through Windows System.Speech. Disabled by default to avoid duplicate voices; the queue bridge is the primary ANA voice channel."
        },
        "anaMax.voiceReadoutClipboard": {
          "type": "boolean",
          "default": true,
          "description": "Speak copied chat text through the local chat voice bridge. Private lab only; sensitive words are skipped by the bridge."
        },
        "anaMax.voiceReadoutLogEvents": {
          "type": "boolean",
          "default": true,
          "description": "Speak useful Live Console log events such as tool start/end, MCP call results, watchdog warnings, and audit/reload status while still filtering mirror/heartbeat screenshot noise."
        },
        "anaMax.voiceAccessibilityCues": {
          "type": "boolean",
          "default": true,
          "description": "Enable private-lab accessibility audio cues for ANA buttons, action start/end, server readiness, and Voice Inbox phrase completion."
        },
        "anaMax.voiceButtonAnnouncements": {
          "type": "boolean",
          "default": true,
          "description": "Speak a short label when ANA MAX Activity Bar or command-palette actions are triggered."
        },
        "anaMax.voiceActionCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Speak a short completion or failure message when ANA MAX actions finish."
        },
        "anaMax.voiceOrientationCues": {
          "type": "boolean",
          "default": true,
          "description": "Speak deduplicated screen-orientation cues from mirror/watchdog logs, such as the active app and window title."
        },
        "anaMax.voiceOrientationMinIntervalMs": {
          "type": "number",
          "default": 20000,
          "description": "Minimum delay before repeating the same spoken screen-orientation cue."
        },
        "anaMax.voiceCueBeeps": {
          "type": "boolean",
          "default": true,
          "description": "Play short beep cues for button, start, success, failure, ready, and phrase-completion events."
        },
        "anaMax.voiceReadoutMaxChars": {
          "type": "number",
          "default": 260,
          "description": "Maximum characters spoken from one filtered Live Console line."
        },
        "anaMax.voiceFullReadout": {
          "type": "boolean",
          "default": true,
          "description": "Speak long ANA queue and copied-chat text in chunks instead of skipping or truncating it."
        },
        "anaMax.voiceFullReadoutMaxChars": {
          "type": "number",
          "default": 6000,
          "description": "Maximum total characters spoken for one full-readout ANA queue or copied-chat event."
        },
        "anaMax.voiceFullReadoutChunkChars": {
          "type": "number",
          "default": 700,
          "description": "Characters per spoken chunk when full voice readout is enabled."
        },
        "anaMax.voiceReadoutMinIntervalMs": {
          "type": "number",
          "default": 1500,
          "description": "Minimum delay between spoken Live Console lines."
        },
        "anaMax.voiceInboxAutoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the private-lab microphone Voice Inbox daemon when the ANA Live Console opens."
        },
        "anaMax.voiceInboxAutoSubmit": {
          "type": "boolean",
          "default": true,
          "description": "Automatically paste recognized Voice Inbox text into the focused allowed window when it starts with an allowed prefix."
        },
        "anaMax.voiceInboxPressEnter": {
          "type": "boolean",
          "default": true,
          "description": "Press Enter after Voice Inbox auto-submit. Keep the Codex/ChatGPT input focused before speaking."
        },
        "anaMax.voiceInboxDuration": {
          "type": "number",
          "default": 8,
          "description": "Seconds for each repeated Voice Inbox listening window, from 2 to 30."
        },
        "anaMax.voiceInboxSubmitPrefix": {
          "type": "string",
          "default": "codex,ana",
          "description": "Comma-separated words that must start recognized speech before Voice Inbox auto-submit runs."
        },
        "anaMax.voiceInboxAllowedTitles": {
          "type": "string",
          "default": "Visual Studio Code,Code,Codex,ChatGPT",
          "description": "Comma-separated foreground window title fragments where Voice Inbox auto-submit is allowed."
        },
        "anaMax.conversationAuditLiveAutoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically stream ANA conversation audit events into the Live Console in real time."
        }
      }
    }
  }
}
